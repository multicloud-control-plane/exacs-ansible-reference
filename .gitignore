crash.log
*.pem
*.key
.venv/
__pycache__/

# Internal working documents. They are kept locally but not published: the
# validation record describes the lab environment, the workshop runbook is
# a facilitator script, and the FAQ is prep notes for live Q&A — none of them
# are part of the deliverable.
/docs/validation-plan.md
/docs/workshop-runbook.md
/docs/workshop-faq.md

# Completed operation manifests carry real OCIDs and must never reach GitHub.
# The examples live under ansible/example/{yaml,json}/ and are tracked
# normally; this only guards against a real manifest dropped at the
# ansible/ root instead of under manifests/. requirements.yml is the one
# real *.yml this repo tracks at that root.
/ansible/*.yml
/ansible/*.json
!/ansible/requirements.yml

# Real manifests organized per VM Cluster (see docs/customer-guide.md). Whole
# subtree is real customer data, regardless of file extension.
/ansible/manifests/
