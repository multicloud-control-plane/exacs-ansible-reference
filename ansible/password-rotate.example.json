{
  "_notes": [
    "Copy this file to password-rotate.json. The CDB is resolved from OCI facts",
    "through the same ownership tags as every other operation. OCI never returns",
    "the password, so there is nothing to verify afterwards except that the CDB",
    "stayed available through the change."
  ],
  "operation_execution_mode": "precheck",
  "exacs_project": "customer-demo",
  "exacs_environment": "nonprod",
  "exacs_rotate_compartment_id": "ocid1.compartment.oc1..example",
  "exacs_rotate_vm_cluster_id": "ocid1.cloudvmcluster.oc1.uk-london-1.example",

  "exacs_rotate_database_name": "EXACREF",
  "exacs_rotate_database_key": "exacref_cdb",
  "exacs_rotate_new_admin_password": "{{ lookup('ansible.builtin.env', 'EXACS_NEW_ADMIN_PASSWORD') }}",
  "exacs_rotate_timeout_seconds": 3600
}
